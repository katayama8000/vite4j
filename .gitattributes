# Normalise line endings on the way in; check out whatever the platform uses.
* text=auto

*.java text diff=java
*.xml text
*.md text
*.yml text
*.properties text

# Shell scripts stay LF even on Windows, or they will not run.
*.sh text eol=lf
mvnw text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Keep binaries out of diffs and merges.
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary

# The language bar should show what this project is, not its build files.
pom.xml linguist-detectable=false
*.md linguist-documentation
